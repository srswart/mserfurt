# Intermediate / generated output
snapshots/
training/
!shared/training/
shared/training/*
!shared/training/konrad_hand_recovery/
# External-backup evidence: retain local files, exclude raw runs and renders.
# Keep candidates, contracts, approvals, reports, manifests and review records.
# See docs/evidence-storage.md before cleanup or restoring a fresh checkout.
/shared/training/konrad_hand_recovery/**/*.json.gz
/shared/training/konrad_hand_recovery/**/document.json
/shared/training/konrad_hand_recovery/**/documents.json
/shared/training/konrad_hand_recovery/**/measurement.json
/shared/training/konrad_hand_recovery/**/attempt.json
/shared/training/konrad_hand_recovery/**/*.png
/shared/training/konrad_hand_recovery/**/*.svg
/shared/training/konrad_hand_recovery/**/*.html
/shared/training/konrad_hand_recovery/**/.preview/
/shared/training/konrad_hand_recovery/**/worker.log
render-output/
weather-output/
debug/

# Manuscript reference images (large binary data)
reference/*
!reference/konrad_word_recovery_v1/
!reference/konrad_hand_recovery_v2/
!reference/konrad_hand_recovery_v3/
docs/samples/

# ScribeSim runtime caches
scribesim/refextract/
scribesim/refselect/
scribesim/transcribe/

# ScribeHand (TD-018): track corpus config/manifests, ignore heavy data
!shared/training/scribehand/
shared/training/scribehand/**/images/
shared/training/scribehand/exports/
shared/models/scribehand/weights/

# TD-019 Human-Eyes Review records: track JSON manifests and review verdicts, ignore rendered PNGs/HTML/XML
!shared/training/reviews/
/shared/training/reviews/**/*.png
/shared/training/reviews/**/*.html
/shared/training/reviews/**/*.xml
!shared/training/handsim/
shared/training/handsim/*
!shared/training/handsim/reviewed_annotations/
shared/training/handsim/reviewed_annotations/*
!shared/training/handsim/reviewed_annotations/bsb_confirmed_words_v1.json

# ScribeHand orchestration local state (machine-specific paths)
diagnostics/.scribehand-orchestration-state.json
diagnostics/scribehand.env

# ARRIVE runtime state
.arrive/

# Dependency lockfile
uv.lock


