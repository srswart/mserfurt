      "number": 6,
      "text": "ausgewählter Predigten Eckharts vollendet hatte,",
      "register": "de",
      "annotations": [
        {
          "type": "confidence",
          "detail": {
            "score": 0.96
          }
        }
      ],
      "english": "an edition of selected Eckhart sermons,"
    },
    {
      "number": 7,
      "text": "und der Setzer — der nach einer Straßburger",
      "register": "de",
      "annotations": [
        {
          "type": "confidence",
          "detail": {
            "score": 0.96
          }
        }
      ],
      "english": "and the compositor — working from a Strasbourg"
    },
    {
      "number": 8,
