      "register": "de",
      "annotations": [
        {
          "type": "confidence",
          "detail": {
            "score": 0.96
          }
        }
      ],
      "english": "manuscript that descended from mine —"
    },
    {
      "number": 9,
      "text": "hatte die zwölffte Predigt mit jener Lesart gesetzet:",
      "register": "de",
      "annotations": [
        {
          "type": "confidence",
          "detail": {
            "score": 0.96
          }
        }
      ],
      "english": "had set the twelfth sermon with that variant reading:"
    },
    {
      "number": 10,
      "text": "Wirt.",
      "register": "mhg",
      "annotations": [
        {
          "type": "confidence",
          "detail": {
            "score": 0.96
          }
        }
      ],
      "english": "Wirt. (Becomes.)"
    },
    {
      "number": 11,
      "text": "Er legte ein eintzelnes gedrucktes Blat bey. Er",
      "register": "de",
      "annotations": [
        {
          "type": "confidence",
          "detail": {
            "score": 0.96
          }
        }
      ],
      "english": "He enclosed a single printed leaf. He"
