      "english": "wrote that the word was now in three hundred copies"
    },
    {
      "number": 13,
      "text": "in vier Städten verbreitet, und er selber halte die",
      "register": "de",
      "annotations": [
        {
          "type": "confidence",
          "detail": {
            "score": 0.96
          }
