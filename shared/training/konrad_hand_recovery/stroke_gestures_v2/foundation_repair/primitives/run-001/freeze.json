      "actual_desired_loss": 0.35,
      "corridor_mm": 0.25,
      "convergence_image": 0.03,
      "endpoint_mm": 0.01,
      "event_time_s": 0.0001,
      "contact_text_owner_errors": 0,
      "blank_ink_fraction": 0.01,
      "blank_regions": "Per return local x[0.20,0.30]; lower y[0.18,0.28], upper y[-0.28,-0.18]. Open interior probes, not closed-counter acceptance; report target occupancy too and fail if region is not actually blank. Use grayscale<180 ink fraction.",
      "motion": "Also require unchanged motion mechanical, desired acceleration, entry, corner, time and no-projection checks; report every refinement, not just base.",
      "fixed_null": "Unchanged initializer loss ratio1 (not required to pass improvement). Empty-image global control loss >=0.1 per fixture. No placement freedom exists."
    },
    "negative_control_handoff": "HANDVALIDATE-015 must independently run wrong-port/direction, detached geometry, hidden lift/air connector, extra terminal/overlap and erased-counter controls with exact ownership and predeclared local regions. Retain old global0.1 sensitivity failures. This learning run reports fixed/blank nulls and does not self-certify the independent adversarial gate.",
    "completion": "All seeds execute with per-family unseen benefit and contact/refinement evidence; any failure leaves learning in progress. No new S1, gesture-fitting permission, historical or human appearance acceptance."
